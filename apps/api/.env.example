# Server Configuration
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# Supabase PostgreSQL Connections (Mumbai: ap-south-1)
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-1-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-1-ap-south-1.pooler.supabase.com:5432/postgres"

# JWT Authentication (Argon2id password hashing is handled by backend service)
JWT_SECRET=your-256-bit-jwt-secret-placeholder-min-32-chars
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your-256-bit-refresh-secret-placeholder
JWT_REFRESH_EXPIRES_IN=30d

# SMTP Email Configuration
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=no-reply@segacademy.com
SMTP_PASS=your-smtp-password-placeholder
SMTP_FROM="SEG Academy <no-reply@segacademy.com>"

# Private Storage (Supabase Storage / S3-compatible private bucket)
STORAGE_PROVIDER=supabase
STORAGE_BUCKET=seg-crm-documents
STORAGE_ENDPOINT=https://[YOUR-PROJECT-REF].supabase.co/storage/v1
STORAGE_ACCESS_KEY=your-storage-access-key-placeholder
STORAGE_SECRET_KEY=your-storage-secret-key-placeholder
