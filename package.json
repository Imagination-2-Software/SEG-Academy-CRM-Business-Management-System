{
  "name": "seg-crm",
  "version": "0.1.0",
  "private": true,
  "description": "SEG Academy CRM - Modular Monolith Monorepo",
  "packageManager": "npm@11.20.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "test:e2e": "playwright test",
    "clean": "turbo run clean && rimraf node_modules",
    "db:generate": "npm --workspace=@seg/database run generate",
    "db:push": "npm --workspace=@seg/database run push",
    "db:studio": "npm --workspace=@seg/database run studio"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^22.13.5",
    "turbo": "^2.4.4",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "allowScripts": {
    "@nestjs/core@10.4.22": true,
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "prisma@6.19.3": true
  }
}
