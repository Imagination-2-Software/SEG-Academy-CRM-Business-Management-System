# Root Local Staging Environment Template - SEG Academy CRM Monorepo
#
# Usage Instructions:
# 1. Copy this file to `.env.staging` (or `.env.local` for local staging overrides).
# 2. Both `.env.staging` and `.env.local` are strictly ignored by Git.
# 3. Replace all placeholder values with your local development/staging credentials.
# 4. NEVER COMMIT REAL SECRETS OR PASSWORDS.

# === API Runtime Configuration ===
PORT=4000
NODE_ENV=staging
CORS_ORIGIN=http://localhost:3000

# === Local PostgreSQL 17 Staging Connections ===
# Direct Administrative / Migration Connection (Prisma CLI, DDL, Initial Setup)
# Uses PostgreSQL superuser `postgres` on port 5432
DIRECT_URL="postgresql://postgres:[LOCAL_POSTGRES_PASSWORD]@127.0.0.1:5432/seg_crm_staging"

# Runtime Application Connection (Prisma Client & NestJS Services)
# Uses least-privilege application role `seg_api_app` on port 5432
DATABASE_URL="postgresql://seg_api_app:[LOCAL_SEG_API_APP_PASSWORD]@127.0.0.1:5432/seg_crm_staging"

# === Security & Authentication ===
JWT_SECRET=your-local-staging-jwt-secret-placeholder-min-32-chars
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your-local-staging-refresh-secret-placeholder
JWT_REFRESH_EXPIRES_IN=30d

# === Email Integration (Local / Test SMTP) ===
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=test
SMTP_PASS=test
SMTP_FROM="SEG Academy Staging <no-reply@staging.segacademy.com>"

# === Private Storage (Local Mock / Staging S3 or Supabase Storage) ===
STORAGE_PROVIDER=local
STORAGE_BUCKET=seg-crm-staging-documents
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=your-staging-storage-access-key-placeholder
STORAGE_SECRET_KEY=your-staging-storage-secret-key-placeholder

# === Web Frontend URLs ===
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
