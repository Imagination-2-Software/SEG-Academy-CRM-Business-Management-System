# Root Environment Template - SEG Academy CRM Monorepo
# Duplicate this file into apps/api/.env and apps/web/.env with real local values.

# === API Configuration ===
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# === Supabase PostgreSQL Connection ===
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# === Security & Auth ===
JWT_SECRET=your-256-bit-jwt-secret-placeholder-min-32-chars
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your-256-bit-refresh-secret-placeholder
JWT_REFRESH_EXPIRES_IN=30d

# === Email Integration (SMTP) ===
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=no-reply@segacademy.com
SMTP_PASS=your-smtp-password-placeholder
SMTP_FROM="SEG Academy <no-reply@segacademy.com>"

# === Private Storage (Supabase Storage / S3) ===
STORAGE_PROVIDER=supabase
STORAGE_BUCKET=seg-crm-documents
STORAGE_ENDPOINT=https://[YOUR-PROJECT-REF].supabase.co/storage/v1
STORAGE_ACCESS_KEY=your-storage-access-key-placeholder
STORAGE_SECRET_KEY=your-storage-secret-key-placeholder

# === Web Frontend ===
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
