// ==============================================================================
// PROPOSED PRISMA SCHEMA FOR SEG ACADEMY CRM (PHASE 2C.2 FINAL CORRECTIONS)
// Project: SEG CRM
// Database: Supabase PostgreSQL (Mumbai ap-south-1)
// Status: DRAFT / PROPOSED (DO NOT APPLY DIRECTLY WITHOUT APPROVAL)
// Note: Employee-only internal CRM. Student Portal authentication is excluded.
//       Lead Management is strictly excluded.
// ==============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ------------------------------------------------------------------------------
// ENUMS
// ------------------------------------------------------------------------------

enum AccountStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  INVITED
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERN
}

enum InternshipStatus {
  ACTIVE
  COMPLETED
  TERMINATED
}

enum DocumentType {
  TRANSCRIPT
  ID_PROOF
  PASSPORT
  VISA
  CERTIFICATE
  RESUME
  OTHER
}

enum DocumentVerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum BatchStatus {
  UPCOMING
  ONGOING
  COMPLETED
  CANCELLED
}

enum EnrolmentStatus {
  APPLIED
  ENROLLED
  ON_HOLD
  GRADUATED
  DROPPED
  WITHDRAWN
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  CANCELLED
  REFUNDED
}

enum CreditNoteStatus {
  DRAFT
  ISSUED
  APPLIED
  CANCELLED
}

enum DebitNoteStatus {
  DRAFT
  ISSUED
  APPLIED
  CANCELLED
}

enum PaymentMethod {
  BANK_TRANSFER
  CREDIT_CARD
  DEBIT_CARD
  UPI
  CASH
  ONLINE_GATEWAY
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  FAILED
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum RefundStatus {
  REQUESTED
  APPROVED
  PROCESSED
  REJECTED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  UNDER_REVIEW
  DONE
  CANCELLED
}

enum SubmissionStatus {
  DRAFT
  SUBMITTED
  LATE
  RESUBMISSION_REQUESTED
  GRADED
}

enum NotificationChannel {
  IN_APP
  EMAIL
  SMS
}

// ------------------------------------------------------------------------------
// 1. AUTHENTICATION, INTERNAL USERS & UNIFIED RBAC
// ------------------------------------------------------------------------------

model User {
  id           String        @id @default(uuid())
  email        String        @unique
  passwordHash String
  fullName     String
  phoneNumber  String?
  roleId       String
  status       AccountStatus @default(ACTIVE)
  avatarUrl    String?
  lastLoginAt  DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  // Single authoritative Role link
  role Role @relation(fields: [roleId], references: [id], onDelete: Restrict)

  // 1:1 Employee Profile (Internal CRM staff only)
  employee ProfileEmployee?

  // Sessions, Security & Audit
  refreshTokens RefreshToken[]
  auditLogs     AuditLog[]
  notifications Notification[]

  @@index([email])
  @@index([roleId])
  @@index([status])
  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  isRevoked Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())
  userAgent String?
  ipAddress String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("refresh_tokens")
}

model Role {
  id          String   @id @default(uuid())
  code        String   @unique // System codes: "FOUNDER_SUPER_ADMIN", "ADMIN", "TEAM_LEADER", "FINANCE_MANAGER", "EMPLOYEE_INTERN", "TRAINER_FACULTY"
  name        String
  description String?
  isSystem    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       User[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid())
  resource    String   // e.g. "students", "invoices", "payments", "tasks", "courses"
  action      String   // e.g. "create", "read", "update", "delete", "export", "approve"
  description String?
  createdAt   DateTime @default(now())

  roles RolePermission[]

  @@unique([resource, action])
  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

// ------------------------------------------------------------------------------
// 2. DEPARTMENTS, TEAMS, EMPLOYEES & INTERNS
// ------------------------------------------------------------------------------

model Department {
  id          String   @id @default(uuid())
  name        String   @unique
  code        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  teams     Team[]
  employees ProfileEmployee[]
  tasks     Task[]

  @@map("departments")
}

model Team {
  id           String   @id @default(uuid())
  departmentId String
  name         String
  code         String   @unique
  description  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  department Department        @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  employees  ProfileEmployee[]
  tasks      Task[]

  @@unique([departmentId, name])
  @@map("teams")
}

model ProfileEmployee {
  id             String         @id @default(uuid())
  userId         String         @unique
  employeeCode   String         @unique
  jobTitle       String
  employmentType EmploymentType @default(FULL_TIME)
  departmentId   String?
  teamId         String?
  managerId      String?
  joinDate       DateTime
  exitDate       DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  user       User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  department Department?      @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  team       Team?            @relation(fields: [teamId], references: [id], onDelete: SetNull)
  manager    ProfileEmployee? @relation("EmployeeHierarchy", fields: [managerId], references: [id], onDelete: SetNull)
  directReports ProfileEmployee[] @relation("EmployeeHierarchy")

  // Intern Extension
  internProfile   InternDetails?
  mentoredInterns InternDetails[] @relation("InternMentor")

  // Assigned operations
  batchesInstructed   Batch[]              @relation("BatchInstructor")
  verifiedDocuments   StudentDocument[]    @relation("DocumentVerifier")
  recordedPayments    Payment[]            @relation("PaymentRecorder")
  processedRefunds    Refund[]             @relation("RefundProcessor")
  issuedCreditNotes   CreditNote[]         @relation("CreditNoteIssuer")
  issuedDebitNotes    DebitNote[]          @relation("DebitNoteIssuer")
  assignedTasks       Task[]               @relation("TaskAssignee")
  createdTasks        Task[]               @relation("TaskCreator")
  createdAssignments  Assignment[]         @relation("AssignmentCreator")
  reviewedSubmissions SubmissionReview[]   @relation("SubmissionReviewer")

  @@index([departmentId])
  @@index([teamId])
  @@index([managerId])
  @@map("employees")
}

model InternDetails {
  id             String           @id @default(uuid())
  employeeId     String           @unique
  mentorId       String?
  status         InternshipStatus @default(ACTIVE)
  startDate      DateTime
  endDate        DateTime
  collegeName    String?
  academicDegree String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  employee ProfileEmployee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  mentor   ProfileEmployee? @relation("InternMentor", fields: [mentorId], references: [id], onDelete: SetNull)

  @@map("intern_details")
}

// ------------------------------------------------------------------------------
// 3. STUDENTS & STUDENT DOCUMENTS (BUSINESS RECORDS ONLY, NO USER AUTH)
// ------------------------------------------------------------------------------

model ProfileStudent {
  id               String    @id @default(uuid())
  studentCode      String    @unique
  fullName         String
  email            String    @unique
  phoneNumber      String?
  dateOfBirth      DateTime?
  gender           String?
  nationality      String?
  addressLine1     String?
  addressLine2     String?
  city             String?
  state            String?
  country          String?
  postalCode       String?
  emergencyContact String?
  guardianName     String?
  guardianPhone    String?
  guardianEmail    String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  documents   StudentDocument[]
  enrolments  Enrolment[]
  invoices    Invoice[]
  payments    Payment[]
  creditNotes CreditNote[]
  debitNotes  DebitNote[]
  submissions Submission[]

  @@index([email])
  @@index([studentCode])
  @@map("students")
}

model StudentDocument {
  id                 String                     @id @default(uuid())
  studentId          String
  documentType       DocumentType
  documentName       String
  fileStorageKey     String                     @unique // Supabase Private Bucket storage path
  mimeType           String
  fileSizeBytes      Int
  verificationStatus DocumentVerificationStatus @default(PENDING)
  verifiedById       String?
  verifiedAt         DateTime?
  rejectionReason    String?
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt

  student    ProfileStudent   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  verifiedBy ProfileEmployee? @relation("DocumentVerifier", fields: [verifiedById], references: [id], onDelete: SetNull)

  @@index([studentId])
  @@index([verificationStatus])
  @@map("student_documents")
}

// ------------------------------------------------------------------------------
// 4. COURSES, BATCHES & ENROLMENTS
// ------------------------------------------------------------------------------

model Course {
  id            String   @id @default(uuid())
  code          String   @unique
  title         String
  description   String?
  durationWeeks Int
  totalCredits  Int?
  baseFee       Decimal  @db.Decimal(12, 2)
  currency      String   @default("INR")
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  batches      Batch[]
  invoiceItems InvoiceItem[]

  @@index([code])
  @@index([isActive])
  @@map("courses")
}

model Batch {
  id           String      @id @default(uuid())
  courseId     String
  batchCode    String      @unique
  name         String
  startDate    DateTime
  endDate      DateTime?
  capacity     Int
  status       BatchStatus @default(UPCOMING)
  instructorId String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  course     Course           @relation(fields: [courseId], references: [id], onDelete: Restrict)
  instructor ProfileEmployee? @relation("BatchInstructor", fields: [instructorId], references: [id], onDelete: SetNull)

  enrolments  Enrolment[]
  assignments Assignment[]

  @@index([courseId])
  @@index([instructorId])
  @@index([status])
  @@map("batches")
}

model Enrolment {
  id              String          @id @default(uuid())
  studentId       String
  batchId         String
  enrolmentNumber String          @unique
  enrolmentDate   DateTime        @default(now())
  status          EnrolmentStatus @default(ENROLLED)
  finalGrade      String?
  completionDate  DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  student ProfileStudent @relation(fields: [studentId], references: [id], onDelete: Restrict)
  batch   Batch          @relation(fields: [batchId], references: [id], onDelete: Restrict)

  invoices Invoice[]

  @@unique([studentId, batchId])
  @@index([studentId])
  @@index([batchId])
  @@index([status])
  @@map("enrolments")
}

// ------------------------------------------------------------------------------
// 5. INVOICES, ITEMS, PAYMENTS, CREDIT/DEBIT NOTES & REFUNDS
// ------------------------------------------------------------------------------

model Invoice {
  id             String        @id @default(uuid())
  invoiceNumber  String        @unique
  studentId      String
  enrolmentId    String?
  issueDate      DateTime
  dueDate        DateTime
  subtotal       Decimal       @db.Decimal(12, 2)
  taxAmount      Decimal       @default(0.00) @db.Decimal(12, 2)
  discountAmount Decimal       @default(0.00) @db.Decimal(12, 2)
  totalAmount    Decimal       @db.Decimal(12, 2)
  paidAmount     Decimal       @default(0.00) @db.Decimal(12, 2)
  currency       String        @default("INR")
  status         InvoiceStatus @default(DRAFT)
  version        Int           @default(1) // Optimistic locking & immutability version
  isFinalized    Boolean       @default(false)
  notes          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  student   ProfileStudent @relation(fields: [studentId], references: [id], onDelete: Restrict)
  enrolment Enrolment?     @relation(fields: [enrolmentId], references: [id], onDelete: SetNull)

  items       InvoiceItem[]
  payments    Payment[]
  refunds     Refund[]
  creditNotes CreditNote[]
  debitNotes  DebitNote[]

  @@index([studentId])
  @@index([enrolmentId])
  @@index([status])
  @@index([invoiceNumber])
  @@map("invoices")
}

model InvoiceItem {
  id          String   @id @default(uuid())
  invoiceId   String
  courseId    String?
  description String
  quantity    Int      @default(1)
  unitPrice   Decimal  @db.Decimal(12, 2)
  amount      Decimal  @db.Decimal(12, 2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  course  Course? @relation(fields: [courseId], references: [id], onDelete: SetNull)

  @@index([invoiceId])
  @@map("invoice_items")
}

model CreditNote {
  id               String           @id @default(uuid())
  creditNoteNumber String           @unique
  invoiceId        String
  studentId        String
  amount           Decimal          @db.Decimal(12, 2)
  currency         String           @default("INR")
  reason           String
  status           CreditNoteStatus @default(DRAFT)
  issuedById       String?
  issuedAt         DateTime?
  notes            String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  invoice  Invoice          @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  student  ProfileStudent   @relation(fields: [studentId], references: [id], onDelete: Restrict)
  issuedBy ProfileEmployee? @relation("CreditNoteIssuer", fields: [issuedById], references: [id], onDelete: SetNull)

  @@index([invoiceId])
  @@index([studentId])
  @@index([status])
  @@map("credit_notes")
}

model DebitNote {
  id              String          @id @default(uuid())
  debitNoteNumber String          @unique
  invoiceId       String
  studentId       String
  amount          Decimal         @db.Decimal(12, 2)
  currency        String          @default("INR")
  reason          String
  status          DebitNoteStatus @default(DRAFT)
  issuedById      String?
  issuedAt        DateTime?
  notes           String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  invoice  Invoice          @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  student  ProfileStudent   @relation(fields: [studentId], references: [id], onDelete: Restrict)
  issuedBy ProfileEmployee? @relation("DebitNoteIssuer", fields: [issuedById], references: [id], onDelete: SetNull)

  @@index([invoiceId])
  @@index([studentId])
  @@index([status])
  @@map("debit_notes")
}

model Payment {
  id                      String        @id @default(uuid())
  paymentNumber           String        @unique
  invoiceId               String
  studentId               String
  amount                  Decimal       @db.Decimal(12, 2)
  currency                String        @default("INR")
  method                  PaymentMethod
  status                  PaymentStatus @default(PENDING)
  transactionReference    String?
  idempotencyKey          String        @unique // Required: eliminates duplicate payments at DB level
  idempotencyPayloadHash  String?       // SHA-256 hash of original request payload to detect tampering on retries
  gatewayProvider         String?       // e.g. "RAZORPAY", "STRIPE", "MANUAL_CASH", "BANK_NEFT"
  gatewayOrderId          String?
  paidAt                  DateTime?
  recordedById            String?
  notes                   String?
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt

  invoice    Invoice          @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  student    ProfileStudent   @relation(fields: [studentId], references: [id], onDelete: Restrict)
  recordedBy ProfileEmployee? @relation("PaymentRecorder", fields: [recordedById], references: [id], onDelete: SetNull)

  refunds Refund[]

  @@unique([id, invoiceId]) // Required for composite foreign key constraint from Refund
  @@index([invoiceId])
  @@index([studentId])
  @@index([status])
  @@index([idempotencyKey])
  @@map("payments")
}

model Refund {
  id                     String       @id @default(uuid())
  refundNumber           String       @unique
  paymentId              String
  invoiceId              String
  amount                 Decimal      @db.Decimal(12, 2)
  currency               String       @default("INR")
  reason                 String
  status                 RefundStatus @default(REQUESTED)
  idempotencyKey         String       @unique // Required: eliminates duplicate refund retries
  idempotencyPayloadHash String?      // SHA-256 hash of original request payload
  processedById          String?
  processedAt            DateTime?
  rejectionReason        String?
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt

  // Composite foreign key enforcing that paymentId and invoiceId must belong to the exact same row in payments
  payment     Payment          @relation(fields: [paymentId, invoiceId], references: [id, invoiceId], onDelete: Restrict)
  invoice     Invoice          @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  processedBy ProfileEmployee? @relation("RefundProcessor", fields: [processedById], references: [id], onDelete: SetNull)

  @@index([paymentId])
  @@index([invoiceId])
  @@index([status])
  @@index([idempotencyKey])
  @@map("refunds")
}

// ------------------------------------------------------------------------------
// 6. TASKS, ASSIGNMENTS, SUBMISSIONS & REVIEWS
// ------------------------------------------------------------------------------

model Task {
  id           String       @id @default(uuid())
  title        String
  description  String?
  assignedToId String?
  createdById  String
  departmentId String?
  teamId       String?
  priority     TaskPriority @default(MEDIUM)
  status       TaskStatus   @default(TODO)
  dueDate      DateTime?
  completedAt  DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  assignedTo ProfileEmployee? @relation("TaskAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdBy  ProfileEmployee  @relation("TaskCreator", fields: [createdById], references: [id], onDelete: Restrict)
  department Department?      @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  team       Team?            @relation(fields: [teamId], references: [id], onDelete: SetNull)

  @@index([assignedToId])
  @@index([createdById])
  @@index([departmentId])
  @@index([teamId])
  @@index([status])
  @@map("tasks")
}

model Assignment {
  id          String   @id @default(uuid())
  batchId     String
  createdById String
  title       String
  description String?
  totalMarks  Decimal  @default(100.00) @db.Decimal(5, 2)
  dueDate     DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  batch     Batch           @relation(fields: [batchId], references: [id], onDelete: Restrict)
  createdBy ProfileEmployee @relation("AssignmentCreator", fields: [createdById], references: [id], onDelete: Restrict)

  submissions Submission[]

  @@index([batchId])
  @@index([createdById])
  @@map("assignments")
}

model Submission {
  id             String           @id @default(uuid())
  assignmentId   String
  studentId      String
  submissionDate DateTime         @default(now())
  contentUrl     String?          // Storage key in Supabase private bucket
  notes          String?
  status         SubmissionStatus @default(SUBMITTED)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  assignment Assignment     @relation(fields: [assignmentId], references: [id], onDelete: Restrict)
  student    ProfileStudent @relation(fields: [studentId], references: [id], onDelete: Restrict)

  reviews SubmissionReview[]

  @@unique([assignmentId, studentId])
  @@index([assignmentId])
  @@index([studentId])
  @@index([status])
  @@map("submissions")
}

model SubmissionReview {
  id           String   @id @default(uuid())
  submissionId String
  reviewerId   String
  score        Decimal  @db.Decimal(5, 2)
  feedback     String?
  reviewedAt   DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  submission Submission      @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  reviewer   ProfileEmployee @relation("SubmissionReviewer", fields: [reviewerId], references: [id], onDelete: Restrict)

  @@index([submissionId])
  @@index([reviewerId])
  @@map("submission_reviews")
}

// ------------------------------------------------------------------------------
// 7. NOTIFICATIONS (INTERNAL USERS)
// ------------------------------------------------------------------------------

model Notification {
  id        String              @id @default(uuid())
  userId    String
  title     String
  body      String
  channel   NotificationChannel @default(IN_APP)
  isRead    Boolean             @default(false)
  readAt    DateTime?
  metadata  Json?
  createdAt DateTime            @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
  @@map("notifications")
}

// ------------------------------------------------------------------------------
// 8. AUDIT LOGS (SECURITY & COMPLIANCE)
// ------------------------------------------------------------------------------

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  action     String   // e.g. "USER_LOGIN", "INVOICE_ISSUED", "PAYMENT_CONFIRMED"
  resource   String   // e.g. "users", "invoices", "payments"
  resourceId String?  // ID of affected entity
  payload    Json?    // Before/after state snapshot or metadata
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([resource, resourceId])
  @@index([createdAt])
  @@map("audit_logs")
}
