# Local PostgreSQL 17 Staging Configuration Template
# Package: @seg/database
# 
# Usage Instructions:
# 1. Copy this file to `packages/database/.env.staging` (which is git-ignored)
#    or copy directly to `packages/database/.env` when pointing Prisma CLI exclusively at local staging.
# 2. Replace placeholder passwords with your local credentials.
# 3. DO NOT COMMIT REAL PASSWORDS.

# === Migration & Administrative Connection (Prisma CLI / Migrations) ===
# Connects as superuser/postgres over direct TCP session on port 5432.
# Prioritized by Prisma CLI (`prisma migrate`, `prisma db push`) for DDL & role management.
DIRECT_URL="postgresql://postgres:[LOCAL_POSTGRES_PASSWORD]@127.0.0.1:5432/seg_crm_staging"

# === Application Runtime Connection (Prisma Client Runtime) ===
# Connects as least-privilege runtime role `seg_api_app` on port 5432.
# Used by `@prisma/client` during application execution and integration queries.
DATABASE_URL="postgresql://seg_api_app:[LOCAL_SEG_API_APP_PASSWORD]@127.0.0.1:5432/seg_crm_staging"
